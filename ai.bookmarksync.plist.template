<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Unique identifier for this launch agent -->
    <key>Label</key>
    <string>ai.bookmarksync</string>

    <!-- Program to execute -->
    <key>ProgramArguments</key>
    <array>
        <string>{{NODE_PATH}}</string>
        <string>{{PROJECT_DIR}}/dist/index.js</string>
    </array>

    <!-- Run every hour -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <!-- Run on load (when computer starts) -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Standard output log -->
    <key>StandardOutPath</key>
    <string>{{HOME_DIR}}/Library/Logs/bookmark-sync-stdout.log</string>

    <!-- Standard error log -->
    <key>StandardErrorPath</key>
    <string>{{HOME_DIR}}/Library/Logs/bookmark-sync-stderr.log</string>

    <!-- Working directory -->
    <key>WorkingDirectory</key>
    <string>{{PROJECT_DIR}}</string>

    <!-- Environment variables -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
